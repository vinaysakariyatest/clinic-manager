generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id           String        @id @default(uuid())
  phone        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model PatientState {
  phone                 String    @id
  conversationState     String    @default("IDLE")
  lastSuggestedDoctorId String?
  lastSymptoms          String?
  lastProposedTime      DateTime?
  lastSuggestedSlots    String[]  @default([])
  updatedAt             DateTime  @default(now()) @updatedAt
}

model Doctor {
  id             String        @id @default(uuid())
  name           String
  specialization String
  closeTime      Int           @default(18)
  openTime       Int           @default(9)
  appointments   Appointment[]
}

model Appointment {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  date      DateTime
  status    String   @default("PENDING")
  symptoms  String?
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model ClinicConfig {
  id        String   @id @default("default")
  name      String   @default("City Medical Center")
  address   String   @default("123 Main St, New Delhi")
  openTime  Int      @default(9)
  closeTime Int      @default(18)
  offDays   Int[]    @default([0])
  updatedAt DateTime @default(now()) @updatedAt
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  reason    String?
  createdAt DateTime @default(now())
}

model WhatsAppMessage {
  id          String   @id @default(uuid())
  messageId   String   @unique
  channel     String?
  fromNumber  String
  toNumber    String?
  senderName  String?
  contentType String?
  contentText String?
  eventType   String?
  receivedAt  DateTime @default(now())
  rawPayload  Json?
  createdAt   DateTime @default(now())
}
